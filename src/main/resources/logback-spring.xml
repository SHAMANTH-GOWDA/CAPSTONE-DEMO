<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <!-- Log file location -->
    <property name="LOG_PATH" value="logs"/>

    <!-- Console logging -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS}
                %-5level
                [%thread]
                %logger{36}
                -
                %msg%n
            </pattern>
        </encoder>

    </appender>


    <!-- File logging -->
    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/capstone.log</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/capstone.%d{yyyy-MM-dd}.log
            </fileNamePattern>

            <!-- Keep logs for 30 days -->
            <maxHistory>30</maxHistory>

        </rollingPolicy>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS}
                %-5level
                [%thread]
                %logger{36}
                -
                %msg%n
            </pattern>
        </encoder>

    </appender>


    <!-- Root logger -->
    <root level="INFO">

        <appender-ref ref="CONSOLE"/>

        <appender-ref ref="FILE"/>

    </root>

</configuration>